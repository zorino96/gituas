generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AdCampaign {
  id                     String         @id @default(cuid())
  projectId              String
  platform               Platform
  externalCampaignId     String?
  name                   String
  status                 CampaignStatus @default(DRAFT)
  budgetCents            Int
  spentCents             Int            @default(0)
  revenueAttributedCents Int            @default(0)
  cpaCents               Int?
  roas                   Float?
  copy                   String
  creativeUrl            String?
  targeting              Json?
  startedAt              DateTime?
  endedAt                DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([platform])
  @@index([projectId])
}

model AiUsage {
  id                String   @id @default(cuid())
  tenantId          String
  date              DateTime @db.Date
  callCount         Int      @default(0)
  totalInputTokens  Int      @default(0)
  totalOutputTokens Int      @default(0)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  projectId   String
  kind        ApprovalKind
  payload     Json
  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  reason      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String
  projectId   String?
  actor       Actor
  action      String
  reasoning   String?
  metadata    Json?
  initiatedAs MasterMode?
  createdAt   DateTime    @default(now())
  project     Project?    @relation(fields: [projectId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([createdAt])
  @@index([projectId])
  @@index([tenantId])
}

model ContentPost {
  id              String           @id @default(cuid())
  projectId       String
  createdById     String?
  sourceAssetUrl  String
  sourceAssetType AssetType
  description     String
  hashtags        String[]
  status          PostStatus       @default(DRAFT)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants        ContentVariant[]
  platformPosts   PlatformPost[]

  @@index([projectId])
  @@index([status])
}

model ContentVariant {
  id            String      @id @default(cuid())
  contentPostId String
  aspectRatio   AspectRatio
  assetUrl      String
  createdAt     DateTime    @default(now())
  contentPost   ContentPost @relation(fields: [contentPostId], references: [id], onDelete: Cascade)

  @@unique([contentPostId, aspectRatio])
}

model ConversationMessage {
  id                String           @id @default(cuid())
  /// Operator-dashboard rows only; shop rows use storeId.
  projectId         String?
  storeId           String?
  platform          Platform
  channelType       ChannelType
  direction         MessageDirection
  externalThreadId  String?
  externalMessageId String?
  authorHandle      String?
  authorName        String?
  /// Platform user id of the author (comment) or sender (DM).
  authorId          String?
  parentCommentId   String?
  content           String?
  audioUrl          String?
  transcript        String?
  status            MessageStatus    @default(RECEIVED)
  generatedReply    String?
  reasoning         String?
  commentType       String?
  intent            String?
  language          String?
  confidence        Float?
  outcome           MessageOutcome?
  /// Why it was skipped or flagged; non-null means "needs you" in the inbox.
  outcomeReason     String?
  boundProductId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  store             Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobs              OutboxJob[]

  @@unique([storeId, externalMessageId])
  @@index([platform, channelType])
  @@index([projectId])
  @@index([storeId, authorId])
}

model Earnings {
  id                String   @id @default(cuid())
  projectId         String
  periodStart       DateTime
  periodEnd         DateTime
  grossRevenueCents Int
  platformFeeCents  Int
  netCents          Int
  currency          String   @default("USD")
  createdAt         DateTime @default(now())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([periodStart, periodEnd])
  @@index([projectId])
}

model MarketingPlan {
  id          String              @id @default(cuid())
  projectId   String
  data        Json
  status      MarketingPlanStatus @default(DRAFT)
  generatedBy String              @default("gemini")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/// A pending invitation into a workspace. Only the SHA-256 of the link's token
/// is stored; the row is kept after acceptance for the record.
model Invite {
  id          String         @id @default(cuid())
  tenantId    String
  email       String
  role        MembershipRole
  tokenHash   String         @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model MemoryItem {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String?
  kind      String
  content   String
  embedding Json
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, kind])
}

model OAuthCredential {
  id                    String        @id @default(cuid())
  tenantId              String
  provider              OAuthProvider
  providerAccountId     String
  providerAccountName   String?
  avatarUrl             String?
  scopes                String[]
  tokenEncrypted        String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, providerAccountId])
  @@index([tenantId])
}

model OAuthState {
  state        String        @id
  codeVerifier String
  tenantId     String
  provider     OAuthProvider
  redirectTo   String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())

  @@index([expiresAt])
  @@index([tenantId])
}

/// A Facebook sign-in waiting for the person to pick which Page to connect.
/// Holds the long-lived user token (vault-encrypted) for ten minutes; the Page
/// token is minted only for the Page they choose, then the row is deleted.
model OAuthPageChoice {
  id                 String   @id @default(cuid())
  tenantId           String
  userTokenEncrypted String
  /// [{ id, name }] — shown to the person; never trusted on its own.
  pages              Json
  scopes             String[]
  redirectTo         String
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([expiresAt])
}

model PlatformPost {
  id             String      @id @default(cuid())
  contentPostId  String
  platform       Platform
  platformPostId String?
  permalinkUrl   String?
  status         PostStatus  @default(DRAFT)
  errorMessage   String?
  postedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  contentPost    ContentPost @relation(fields: [contentPostId], references: [id], onDelete: Cascade)

  @@unique([contentPostId, platform])
  @@index([platform])
}

model Project {
  id                   String                @id @default(cuid())
  tenantId             String
  name                 String
  slug                 String
  description          String?
  status               ProjectStatus         @default(ACTIVE)
  githubRepoUrl        String?
  githubRepoId         String?
  githubRepoOwner      String?
  githubRepoName       String?
  cloudProvider        CloudProvider?
  productionUrl        String?
  stripeAccountId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode                 ProjectMode?
  personality          ProjectPersonality?
  adCampaigns          AdCampaign[]
  approvalRequests     ApprovalRequest[]
  auditLogs            AuditLog[]
  contentPosts         ContentPost[]
  conversationMessages ConversationMessage[]
  earnings             Earnings[]
  marketingPlans       MarketingPlan[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ProjectMode {
  id              String     @id @default(cuid())
  projectId       String     @unique
  masterMode      MasterMode @default(MANUAL)
  adsMode         AgentMode  @default(OFF)
  contentMode     AgentMode  @default(OFF)
  replyMode       AgentMode  @default(OFF)
  commentMode     AgentMode  @default(OFF)
  scalingMode     AgentMode  @default(OFF)
  requireApproval Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectPersonality {
  id          String   @id @default(cuid())
  projectId   String   @unique
  data        Json
  version     Int      @default(1)
  generatedBy String   @default("claude")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  ownerId               String
  plan                  TenantPlan        @default(MANUAL)
  onboardingDismissedAt DateTime?
  aiDailyCap            Int?
  stripeCustomerId      String?           @unique
  stripeSubscriptionId  String?           @unique
  subscriptionStatus    String?
  subscriptionTier      String?
  currentPeriodEnd      DateTime?
  /// When the paid newsroom plan lapses (Wayl billing); null = never paid.
  planPaidUntil         DateTime?
  /// End of the free newsroom trial; null = no trial (older workspaces, shops).
  trialEndsAt           DateTime?
  discordWebhookUrl     String?
  telegramBotToken      String?
  telegramChatId        String?
  /// International digits for wa.me (e.g. 9647501234567), set in the merchant app.
  whatsappNumber        String?
  /// A shop (comments, messages) or a news page (news desk). Claimed once, by
  /// whichever surface the account first opens — `/newsroom` claims NEWS,
  /// `/app` claims MERCHANT.
  kind                  TenantKind        @default(MERCHANT)
  kindChosen            Boolean           @default(false)
  anthropicKeyEncrypted String?
  googleAiKeyEncrypted  String?
  openaiKeyEncrypted    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  owner                 User              @relation(fields: [ownerId], references: [id])
  aiUsages              AiUsage[]
  auditLogs             AuditLog[]
  memberships           Membership[]
  invites               Invite[]
  oauthCredentials      OAuthCredential[]
  stores                Store[]
  projects              Project[]
  wallet                Wallet?
  invoices              Invoice[]
  scheduledPosts        ScheduledPost[]
  orders                Order[]
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String?      @unique
  emailVerified  DateTime?
  image          String?
  /// scrypt hash for email-and-password sign-in; null for GitHub/Google-only users.
  passwordHash   String?
  /// Raised when the password changes. Sessions are JWTs that can't be deleted,
  /// so a token issued under an older version stops being accepted instead.
  sessionVersion Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  memberships    Membership[]
  sessions       Session[]
  tenants        Tenant[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id           String              @id @default(cuid())
  tenantId     String              @unique
  balanceCents Int                 @default(0)
  currency     String              @default("USD")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  type        TransactionType
  amountCents Int
  currency    String          @default("USD")
  description String
  referenceId String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([walletId])
}

enum Actor {
  USER
  AI_CLAUDE
  AI_GEMINI
  AI_ROUTER
  SYSTEM
}

enum AgentMode {
  AUTO
  MANUAL
  OFF
}

enum ApprovalKind {
  CONTENT_POST
  AD_CAMPAIGN
  REPLY
  COMMENT_ACTION
  DEPLOY
  PRICE_CHANGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AspectRatio {
  RATIO_16_9
  RATIO_9_16
  RATIO_1_1
  RATIO_4_5
}

enum AssetType {
  IMAGE
  VIDEO
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  KILLED
  COMPLETED
}

enum ChannelType {
  DM
  COMMENT
  EMAIL
  VOICE_DM
  MENTION
}

enum CloudProvider {
  VERCEL
  NETLIFY
  HEROKU
  AWS
  RAILWAY
  FLY_IO
  CLOUDFLARE
  OTHER
}

enum MarketingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MasterMode {
  AUTO
  MANUAL
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PENDING_APPROVAL
  SENT
  DECLINED
  FAILED
}

enum OAuthProvider {
  GITHUB
  STRIPE
  META_FACEBOOK
  META_INSTAGRAM
  TIKTOK
  YOUTUBE
  X_TWITTER
  LINKEDIN
  REDDIT
  GOOGLE_ADS
  VERCEL
  CLOUDFLARE
}

enum Platform {
  META_FACEBOOK
  META_INSTAGRAM
  TIKTOK
  YOUTUBE
  X_TWITTER
  LINKEDIN
  REDDIT
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  HIBERNATING
  ARCHIVED
}

enum TenantPlan {
  LITE
  MANUAL
  AUTO
  ENTERPRISE
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SPEND_ADS
  SPEND_API
  SPEND_INFRA
  EARNINGS
  PLATFORM_FEE
  REFUND
}

/// Failed email-and-password sign-ins, for throttling guessing. Rows older than
/// the throttle window are ignored and may be pruned.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// A one-time code emailed to prove an address. A sign-up code carries the
/// pending account (name and password hash), so no user exists until the
/// address is proven and nobody can squat an address they don't own.
model EmailCode {
  id           String    @id @default(cuid())
  email        String
  /// "signup"
  purpose      String
  /// HMAC of the code, keyed with AUTH_SECRET — never the code itself.
  codeHash     String
  name         String?
  passwordHash String?
  attempts     Int       @default(0)
  ip           String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@index([ip, createdAt])
}

enum TenantKind {
  MERCHANT
  NEWS
}

/// A news page's desk settings.
model NewsSettings {
  tenantId      String    @id
  /// Words a story must contain to be shown (any of them); empty = everything.
  keywords      String[]
  lastFetchedAt DateTime?
  updatedAt     DateTime  @updatedAt
  /// "category" or "category/sub" codes to keep; empty keeps everything.
  categories    String[]  @default([])
  /// When on, RSS stories must match the keywords too (the APIs always search by them).
  keywordFilter Boolean   @default(false)
  /// Autopilot: OFF | DRAFT (AI prepares drafts, a person publishes) | PUBLISH (drafts, cards and posts by itself).
  autoMode      String    @default("OFF")
  /// Where PUBLISH posts to: FB and/or IG. TikTok and YouTube are never automatic.
  autoTargets   String[]  @default([])
  autoDailyMax  Int       @default(20)
  /// Minutes between two automatic posts.
  autoMinGapMin Int       @default(3)
  /// The outlet's own style preference, appended to the house style (never overrides the facts-only rules).
  voiceNote     String?
  lastAutoAt    DateTime?
  /// KEYWORDS (the keyword filter above) or PROMPT (the AI keeps only stories that fit the prompts).
  /// PROMPT runs only on plans that include it (src/lib/billing/plans.ts promptFilter).
  filterMode    String    @default("KEYWORDS")
  /// What the desk wants, in the owner's words, e.g. "only news about Donald Trump".
  focusPrompt   String?
  /// ENTERPRISE: what the desk never wants; wins over focusPrompt.
  excludePrompt String?
  /// ENTERPRISE: also keep stories that are only related to the focus.
  focusBroad    Boolean   @default(false)
}

/// One source a news page reads: a catalog entry or the page's own RSS feed.
model NewsSource {
  id        String   @id @default(cuid())
  tenantId  String
  catalogId String?
  rssUrl    String?
  name      String
  enabled   Boolean  @default(true)
  lastError String?
  createdAt DateTime @default(now())

  @@unique([tenantId, catalogId])
  @@unique([tenantId, rssUrl])
  @@index([tenantId])
}

/// A story fetched for a news page: headline and snippet only, never article text.
model NewsItem {
  id            String     @id @default(cuid())
  tenantId      String
  sourceName    String
  url           String
  title         String
  snippet       String
  lang          String?
  publishedAt   DateTime
  clusterKey    String
  /// NEW | DRAFTED | PUBLISHED | DISMISSED
  status        String     @default("NEW")
  createdAt     DateTime   @default(now())
  draft         NewsDraft?
  /// Set by the classifier (src/lib/news/taxonomy.ts codes); null until classified.
  category      String?
  subcategory   String?
  region        String?
  /// Failed classification attempts; after three the story is left unclassified (and still shown).
  classifyTries Int        @default(0)
  /// When the autopilot last handled this story, so a failure is never retried in a loop.
  autoTriedAt   DateTime?
  /// The desk's news prompt: true keeps the story, false hides it, null = not judged yet (shown).
  focusMatch    Boolean?
  /// Failed prompt judgements; after three the story is left unjudged (shown, never auto-posted).
  focusTries    Int        @default(0)

  @@unique([tenantId, url])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, category])
  @@index([tenantId, status, autoTriedAt])
  /// The cross-desk wording check finds the other desks' drafts of one article by its url.
  @@index([url])
}

/// The Sorani post written from one item, and where it went.
model NewsDraft {
  id          String    @id @default(cuid())
  itemId      String    @unique
  item        NewsItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tenantId    String
  headline    String
  body        String
  category    String
  /// STANDARD | BREAKING | STAT | QUOTE
  cardKind    String
  stat        String?
  quote       String?
  speaker     String?
  model       String
  photoPath   String?
  cardUrl     String?
  cardPath    String?
  results     Json?
  publishedAt DateTime?
  /// Written (and possibly posted) by the autopilot rather than by a person.
  auto        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

/// A news page's look: logo, three colours, heading font.
model BrandKit {
  tenantId    String   @id
  logoPath    String?
  primary     String   @default("#0B2545")
  accent      String   @default("#E0A526")
  text        String   @default("#FFFFFF")
  /// kufi | sans — the two fonts the app ships
  headingFont String   @default("kufi")
  updatedAt   DateTime @updatedAt
}

/// Monthly counter per tenant and metric, checked against the plan's quota.
model Usage {
  tenantId String
  /// YYYY-MM (UTC)
  month    String
  metric   String
  count    Int    @default(0)

  @@id([tenantId, month, metric])
}

/// A source's last result, shared across tenants so each feed or query is
/// fetched at most once per window whatever the number of pages reading it.
model SourceCache {
  /// rss:<url> | gdelt:<keywords> | newsdata:<keywords>
  key          String   @id
  items        Json
  fetchedAt    DateTime
  /// Validators from the feed's last 200, sent back as If-None-Match / If-Modified-Since.
  etag         String?
  lastModified String?
}

enum StorePlan {
  FREE
  MERCHANT
  PRO
}

enum OutboxKind {
  PUBLIC_REPLY
  PRIVATE_REPLY
  LIKE
  HIDE
  DM_ANSWER
  DM_PHOTOS
}

enum OutboxStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum MessageOutcome {
  AUTO_REPLIED
  FLAGGED
  SKIPPED
}

/// One connected Facebook Page and/or Instagram account that the shop automates.
model Store {
  id                String               @id @default(cuid())
  tenantId          String
  name              String               @default("")
  fbPageId          String?              @unique
  igUserId          String?              @unique
  igUsername        String?
  plan              StorePlan            @default(FREE)
  /// When the paid shop plan lapses (Wayl billing); null = never paid.
  planPaidUntil     DateTime?
  automationEnabled Boolean              @default(false)
  expiryDays        Int                  @default(30)
  /// Lower than the plan's daily reply cap, when the merchant wants that.
  dailyCap          Int?
  likeComments      Boolean              @default(true)
  autoHideSpam      Boolean              @default(false)
  deliveryFeeMinor  Int?
  deliveryCurrency  String               @default("IQD")
  deliveryTime      String?
  defaultDm         String?
  defaultTemplateId String?
  /// Posts created before this date are never automated ("stop old posts").
  stopBefore        DateTime?
  /// Set when sending must stop (e.g. "token"); cleared on reconnect.
  pausedReason      String?
  /// Last successful webhook subscription.
  webhooksAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products          Product[]
  templates         AutomationTemplate[]
  posts             PostAutomation[]
  jobs              OutboxJob[]
  messages          ConversationMessage[]
  invoices          Invoice[]

  @@index([tenantId])
}

model Product {
  id          String           @id @default(cuid())
  storeId     String
  name        String
  description String?
  photos      String[]
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]

  @@index([storeId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  /// "M", "سوور / L", or "" for a product with one price.
  label       String  @default("")
  amountMinor Int
  currency    String  @default("IQD")
  inStock     Boolean @default(true)
  position    Int     @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AutomationTemplate {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  publicSamples  String[]
  thanksSamples  String[]
  dmGreeting     Boolean  @default(true)
  whatsappAlways Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// One row per post the shop has seen; automation is on by default until activeUntil.
model PostAutomation {
  id             String   @id @default(cuid())
  storeId        String
  platform       Platform
  externalPostId String
  postCreatedAt  DateTime
  enabled        Boolean  @default(true)
  productId      String?
  templateId     String?
  activeUntil    DateTime
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, platform, externalPostId])
  @@index([storeId, postCreatedAt])
}

model OutboxJob {
  id            String              @id @default(cuid())
  storeId       String
  messageId     String
  kind          OutboxKind
  status        OutboxStatus        @default(PENDING)
  payload       Json
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  sentId        String?
  /// Private replies: the buyer's messaging id Meta returns. DM jobs: the target.
  recipientId   String?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message       ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, kind])
  @@index([status, nextAttemptAt])
  @@index([storeId, recipientId])
  @@index([storeId, updatedAt])
}

/// A thread the merchant answered by hand: automation stays out of it.
model ThreadPause {
  id        String   @id @default(cuid())
  tenantId  String
  platform  Platform
  /// Comment threads: the comment id. DMs: the buyer's messaging id.
  threadKey String
  createdAt DateTime @default(now())

  @@unique([tenantId, platform, threadKey])
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

/// One Wayl payment for one plan period. Its id is the Wayl referenceId.
model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  /// Shop invoices pay for one store (page); newsroom invoices for the workspace.
  storeId       String?
  /// "SHOP" | "NEWS"
  product       String
  plan          String
  amountIqd     Int
  status        InvoiceStatus @default(PENDING)
  /// "test" | "live"
  env           String        @default("test")
  webhookSecret String
  waylLinkId    String?
  url           String?
  lastError     String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

enum ScheduleStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// A composer post to publish later (Facebook, Instagram, YouTube — never TikTok).
model ScheduledPost {
  id          String         @id @default(cuid())
  tenantId    String
  createdById String
  /// The composer's PublishInput, as JSON.
  input       Json
  runAt       DateTime
  status      ScheduleStatus @default(PENDING)
  /// The PublishOutcome[] after running.
  result      Json?
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([tenantId, runAt])
}

enum OrderStatus {
  NEW
  CONFIRMED
  SENT
  DELIVERED
  RETURNED
  CANCELLED
}

/// A shop order, entered by the merchant or opened automatically from an ORDER comment/DM.
model Order {
  id               String      @id @default(cuid())
  tenantId         String
  storeId          String?
  customerName     String      @default("")
  phone            String?
  /// Governorate code from src/lib/orders/cities.ts, or null until known.
  city             String?
  address          String?
  productId        String?
  productName      String      @default("")
  variantLabel     String      @default("")
  amountMinor      Int         @default(0)
  currency         String      @default("IQD")
  deliveryFeeMinor Int?
  cod              Boolean     @default(true)
  status           OrderStatus @default(NEW)
  /// "MANUAL" | "COMMENT" | "DM"
  source           String      @default("MANUAL")
  sourceMessageId  String?     @unique
  /// Who asked, from the message's author id (a DM's sender id): lets one buyer's repeat messages share one order.
  buyerKey         String?
  note             String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, city])
  @@index([tenantId, status])
  @@index([tenantId, buyerKey])
}
