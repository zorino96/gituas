# ─── Gituas env template ─────────────────────────────────────────────────────
# Copy to .env and fill in real values. .env is gitignored.

# Database (required) — Neon / any Postgres
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js (required) — generate with: openssl rand -base64 36
AUTH_SECRET=""

# GitHub OAuth (required to sign in) — github.com/settings/developers
# Callback URL: http(s)://<host>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Vault — 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
VAULT_KEY=""

# AI providers — Gemini is the active brain; others optional
GOOGLE_AI_API_KEY=""
# Newsroom voice (src/lib/voice/tts.ts): Sorani via Pawan.krd (pkrd/tts-ku), Arabic/English and the
# Sorani fallback via Gemini 2.5 Flash TTS on GOOGLE_AI_API_KEY. TTS_SORANI="gemini" puts Gemini first.
PAWAN_API_KEY=""
TTS_SORANI=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"

# Cron — Bearer token for /api/cron/run-agents
CRON_SECRET=""

# ─── Platform integrations (add after you get dev access + verify business) ───
# Register each app's callback as: <NEXT_PUBLIC_APP_URL>/api/oauth/<provider>/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="gituas/0.9.4 by your-handle"
# TikTok — Login Kit + Content Posting API. developers.tiktok.com
# Callback / redirect URI: <NEXT_PUBLIC_APP_URL>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# YouTube — uses the Google sign-in client below (AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET).
# In that Google Cloud project: enable "YouTube Data API v3" and add the redirect URI
# <NEXT_PUBLIC_APP_URL>/api/oauth/youtube/callback to the same Web client.
# Google sign-in — callback: http(s)://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Instagram — "Instagram API with Instagram Login". developers.facebook.com
# NOTE: these are the *Instagram* app id/secret from Instagram > API setup,
# NOT the Meta app id/secret on Settings > Basic.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/oauth/meta_instagram/callback
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Webhook verify token (you choose this string) — set the same value in the App
# Dashboard > Instagram > Webhooks. Callback: <APP_URL>/api/meta/webhooks
META_WEBHOOK_VERIFY_TOKEN=""
# Facebook — "Facebook Login for Business" for Page management + Marketing API
# (ads). Can be the same Meta app as Instagram (then reuse INSTAGRAM_APP_ID/SECRET
# values here) or a separate one. Redirect: <APP_URL>/api/oauth/meta_facebook/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Login-configuration ids from App Dashboard > Facebook Login for Business >
# Configurations — one bundling the Pages scopes, one the ads scopes.
FACEBOOK_LOGIN_CONFIG_ID=""
FACEBOOK_ADS_CONFIG_ID=""
# Optional: pin which Page to mint a token for (else the first the user admins).
FACEBOOK_PAGE_ID=""

# Payments / infra (manual API keys via the Integrations admin, or here)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
BLOB_READ_WRITE_TOKEN=""

# The AI stand-by: DeepSeek answers when kurd.gg does not (https://platform.deepseek.com). AI_FALLBACK_ENABLED=0 switches it off.
DEEPSEEK_API_KEY=
AI_FALLBACK_ENABLED=
# Optional news source; the free tier allows commercial use (https://newsdata.io)
NEWSDATA_API_KEY=
# Anthropic key (api.anthropic.com): KURDGG_API_KEY holds the key, KURDGG_BASE_URL=https://api.anthropic.com/v1, KURDGG_MODEL=claude-haiku-5-5; a key not tied to a workspace needs ANTHROPIC_WORKSPACE_ID (wrkspc_...).
# AI_OPUS_ENABLED=0 makes every call Haiku and stops selling the Max plan.
ANTHROPIC_WORKSPACE_ID=
AI_OPUS_ENABLED=

# The chat-first assistant (docs/chat-first/DESIGN.md): CHAT_ENABLED=0 sends everyone back to the older assistant screen.
CHAT_ENABLED=

# The growth coach (the setup interview, the Today cards, the weekly note, the chat's sales advice). 1 = on. Rollback = unset.
BUSINESS_PROFILE_ENABLED=
# The news desk's chat (hawalnoos.com/newsroom/assistant). 1 = on; off keeps the older desk assistant.
NEWS_CHAT_ENABLED=
# Or switch it on for chosen desks only (comma-separated desk ids) while it is being tested.
NEWS_CHAT_TENANTS=
# Owner rules in plain words for customer replies. SHOP_RULES_ENABLED=1 turns the rules on; RULES_DRY_RUN=1 only logs what they would do.
SHOP_RULES_ENABLED=
RULES_DRY_RUN=
# The chat reads each change back from the stored data and says whether it matches what was asked. CHAT_VERIFY=0 switches that off.
CHAT_VERIFY=
