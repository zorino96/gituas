,"height":760,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/1f/Mary_Celeste_as_Amazon_in_1861_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1067,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/1f/Mary_Celeste_as_Amazon_in_1861_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1067},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1f/Mary_Celeste_as_Amazon_in_1861_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Mary_Celeste_as_Amazon_in_1861_(cropped).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=74150472","extmetadata":{"DateTime":{"value":"2019-12-04 00:40:21","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\nBrigantine <i>Amazon</i> entering Marseilles in November 1861. In 1868 she was renamed <i>Mary Celeste</i>. She was found drifting with nobody aboard in November 1872, and is the source of many maritime \"ghost ship\" legends.</div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"November 1861|Honoré Pellegrin|PD-old-100-expired|PD-Art (PD-old-100-expired)|Extracted images|1861 works in France|1861 in water transport|Sailing ships in paintings|CC-PD-Mark|Amazon (ship, 1861)|1861 in transport in France|Paintings without Wikidata item|Brigantines in art|PD-Art missing SDC copyright status|PD-old missing SDC copyright status|Historical images of sailing ships","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<div class=\"fn value\">\nUnconfirmed, possibly Honore Pellegrin (1800–c.1870). T