rn</i>.</li></ul>","source":"commons-desc-page"},"Artist":{"value":"Andreas Keller","source":"commons-desc-page"},"LicenseShortName":{"value":"Copyrighted free use","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Copyrighted free use","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]}]}}