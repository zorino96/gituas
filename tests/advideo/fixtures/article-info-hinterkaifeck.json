6129430","extmetadata":{"ObjectName":{"value":"Hinterkaifeck Flurkarte nach 1870","source":"mediawiki-metadata"},"Categories":{"value":"Hinterkaifeck|Images with annotations|Author died more than 100 years ago public domain images|CC-PD-Mark|Georeferenced maps in Wikimaps Warper","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Flurkarte mit Hinterkaifeck. Zugehörige Ländereien sind farblich markiert.","source":"commons-desc-page"},"Artist":{"value":"<div class=\"fn value\">\nKöniglich Bayerisches Vermessungsamt</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":125999606,"ns":6,"title":"File:Photo - Hinterkaifeck.jpg","imagerepository":"local","imageinfo":[{"size":384711,"width":960,"height":430,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/8/80/Photo_-_Hinterkaifeck.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1280,"thumbheight":573,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/8/80/Photo_-_Hinterkaifeck.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1280,"height":573},"url":"https://upload.wikimedia.org/wikipedia/commons/8/80/Photo_-_Hinterkaifeck.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Photo_-_Hinterkaifeck.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=125999606","extmetadata":{"ObjectName":{"value":"Photo - Hinterkaifeck","source":"mediawiki-metadata"},"Categories":{"value":"Hinterkaifeck|Farmhouses in Bavaria|History of Landkreis Neuburg-Schrobenhausen|PD-anon-expired|Template Unknown (author)","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Photo - Einödhof Hinterkaifeck - before 1922.<br>\n<ul><li>Depiction of the Hinterkaifeck wasteland, labelled <i><b>Hint.-Kaifeck</b></i> in the (official topographic) <a rel=\"nofollow\" class=\"external text\" href=\"https://v.bayern.de/ZNbf9\">position sheet 1:25,000, sheet number 552, year of publication <b>1912</b> on BayernAtlas</a>. The depiction of individual buildings including the place name <i><b>Hint.-Kaifeck</b></i> was retained in the (partially) continued editions of sheet no. 552 from <b>1940</b> and <b>1953</b>. It was not until <b>1959</b>, the year in which the 1:25,000 <i>Schrobenhausen 7433</i> topographic map was published, that the Bavarian State Surveying Office changed the cartographic designation. Landesvermessungsamt added the cartographic symbol <i>\"Gedenkkreuz, Wegkreuz, Bildstock (Marterl)\"</i> at the site of the farm building demolished around 1923. This representation remained on the above map until the year of publication <b>2007</b>, see official topographic map 1:25,000 <a rel=\"nofollow\" class=\"external text\" href=\"https://v.bayern.de/P8348\">Schrobenhausen 7433, year of publication 1995, valid until 2006</a>. In the current map editions, a memorial cross (Marterl) is entered, which was erected approx. 260 metres further southwest on a local road leading off to the east and south, this road leads directly to the <a class=\"external text\" href=\"https://de.wikipedia.org/wiki/Kaifeck_(Waidhofen)\"><i>Kaifeck wasteland in the municipality of Waidhofen</i></a>. Translated with DeepL.com (free version). <br></li>\n<li>Note: German: <i>Gedenkkreuz, Wegkreuz, Bildstock (bayerisch: Marterl)</i> =&gt; English: <i>Memorial cross, wayside cross, wayside shrine (Bavarian: Marterl)</i>.</li></ul>","source":"commons-desc-page"},"Artist":{"value":"Unknown author<span style=\"display: none;\">Unknown author</span>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":187380908,"ns":6,"title":"File:Sterbebildchen der sechs Ermordeten.jpg","imagerepository":"local","imageinfo":[{"size":11413551,"width":3043,"height":5100,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Sterbebildchen_der_sechs_Ermordeten.jpg/1280px-Sterbebildchen_der_sechs_Ermordeten.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":2145,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/7/75/Sterbebildchen_der_sechs_Ermordeten.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Sterbebildchen_der_sechs_Ermordeten.jpg/1280px-Sterbebildchen_der_sechs_Ermordeten.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":2145,"srcset":"https://upload.wikimedia.org/wikipedia/commons/7/75/Sterbebildchen_der_sechs_Ermordeten.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/75/Sterbebildchen_der_sechs_Ermordeten.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Sterbebildchen_der_sechs_Ermordeten.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/in