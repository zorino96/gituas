l am 31. März 1922 die Familie Gabriel-Gruber von hier zum Opfer<span typeof=\"mw:Entity\">\"</span>, gefolgt von den Namen und Geburtsjahren der Opfer.<br>\n<ul><li>Position und Umgebung des ehem. Einödhofes <i>Hinterkaifeck</i> in der amtl. topogr. Karte 1:25.000 auf BayernAtlas: <a rel=\"mw:ExtLink nofollow\" href=\"https://v.bayern.de/J8kQ9\" class=\"external free\">https://v.bayern.de/J8kQ9</a> . Das Gehöft lag rd. 260 Meter nordöstlich vom Marterl (Gedenkstätte), rechts des Weges in Richtung <i>Gröbern</i>.</li></ul>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2007-04-29","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"Andreas Keller","source":"commons-desc-page"},"LicenseShortName":{"value":"Copyrighted free use","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Copyrighted free use","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},{"pageid":9095855,"ns":6,"title":"File:Hinterkaifeck Inschrift.jpg","index":12,"imagerepository":"local","imageinfo":[{"size":2117588,"width":1572,"height":2208,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/a/a1/Hinterkaifeck_Inschrift.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":2247,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/a/a1/Hinterkaifeck_Inschrift.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":2247},"url":"https://upload.wikimedia.org/wikipedia/commons/a/a1/Hinterkaifeck_Inschrift.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_con